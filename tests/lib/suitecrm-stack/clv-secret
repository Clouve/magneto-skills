#!/bin/bash
# Fake clv-secret for the tests: NAME prints the value with no newline, --list the names, --has NAME the
# exit code. A missing name is exit 2 with the real tool's message.
file=/run/clouve/secrets.env
read_file() { if [ -r "${file}" ]; then cat "${file}"; else sudo -n cat "${file}"; fi; }
case "${1:-}" in
    --list) read_file | sed 's/=.*//' ; exit 0 ;;
    --has) read_file | grep -q "^${2}=" ; exit $? ;;
    '') echo "usage: clv-secret NAME | --list | --has NAME" >&2; exit 64 ;;
esac
line="$(read_file | grep "^${1}=" | head -n 1)"
if [ -z "${line}" ]; then
    echo "clv-secret: ${1} is not set on this server" >&2
    exit 2
fi
eval "value=${line#*=}"
printf '%s' "${value}"
