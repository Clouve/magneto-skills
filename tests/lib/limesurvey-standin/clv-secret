#!/bin/bash
# A fake of the Magneto Agent's clv-secret (tests only). It answers from /run/clouve/secrets.env, which root owns
# with mode 0600, through sudo, as the real one does. Each line there is NAME=value.
#   clv-secret NAME     prints the value, with no newline; exit 2 when NAME is not there
#   clv-secret --list   prints the names
#   clv-secret --has NAME
file=/run/clouve/secrets.env
lines="$(sudo -n cat "$file" 2> /dev/null)" || { echo "clv-secret: cannot read the secrets" >&2; exit 3; }
case "${1:-}" in
    --list) printf '%s\n' "$lines" | sed -n 's/=.*//p'; exit 0 ;;
    --has)
        printf '%s\n' "$lines" | grep -q "^${2:-}=" && exit 0
        exit 1
        ;;
    '') echo "usage: clv-secret NAME | --list | --has NAME" >&2; exit 1 ;;
esac
while IFS= read -r line; do
    if [ "${line%%=*}" = "$1" ]; then
        printf '%s' "${line#*=}"
        exit 0
    fi
done <<< "$lines"
echo "clv-secret: $1 is not set on this server" >&2
exit 2
